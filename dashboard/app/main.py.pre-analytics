from datetime import datetime
from fastapi import FastAPI
from fastapi.responses import HTMLResponse, JSONResponse
from sqlalchemy import case, func
from models import Result, get_session

app = FastAPI(title="VLSI Regression Farm Dashboard")


def dashboard_data():
    s = get_session()
    try:
        runs = (
            s.query(
                Result.run_id.label("run_id"),
                func.count(Result.id).label("total"),
                func.sum(case((Result.status == "pass", 1), else_=0)).label("passed"),
                func.sum(case((Result.status == "fail", 1), else_=0)).label("failed"),
                func.max(Result.created_at).label("last_seen"),
            )
            .group_by(Result.run_id)
            .order_by(func.max(Result.created_at).desc())
            .limit(20)
            .all()
        )

        recent_runs = []
        for r in runs:
            total = r.total or 0
            passed = r.passed or 0
            failed = r.failed or 0
            recent_runs.append({
                "run_id": r.run_id,
                "total": total,
                "passed": passed,
                "failed": failed,
                "rate": round(100 * passed / total) if total else 0,
                "last_seen": r.last_seen.isoformat() if r.last_seen else "",
            })

        latest_run = recent_runs[0]["run_id"] if recent_runs else None

        latest_results = []
        if latest_run:
            records = (
                s.query(Result)
                .filter(Result.run_id == latest_run)
                .order_by(Result.id.desc())
                .all()
            )
            latest_results = [{
                "test": r.test,
                "seed": r.seed,
                "status": r.status,
                "duration": r.duration_s,
                "error": r.error_signature or "",
            } for r in records]

        failures = (
            s.query(Result)
            .filter(Result.status == "fail")
            .order_by(Result.created_at.desc())
            .limit(10)
            .all()
        )

        recent_failures = [{
            "run_id": r.run_id,
            "test": r.test,
            "seed": r.seed,
            "error": r.error_signature or "No error signature recorded",
            "created_at": r.created_at.isoformat() if r.created_at else "",
        } for r in failures]

        latest = recent_runs[0] if recent_runs else {
            "run_id": "No campaigns yet",
            "total": 0,
            "passed": 0,
            "failed": 0,
            "rate": 0,
        }

        return {
            "latest": latest,
            "runs": recent_runs,
            "results": latest_results,
            "failures": recent_failures,
            "updated_at": datetime.utcnow().isoformat() + "Z",
        }
    finally:
        s.close()


@app.get("/api/dashboard")
def dashboard_api():
    return JSONResponse(dashboard_data())


@app.get("/", response_class=HTMLResponse)
def index():
    return """
